<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kernel Query | System Monitor</title>
    <link rel="stylesheet" href="css/style.css">
</head>
<body>
    <aside class="sidebar">
        <div class="brand">
            <span class="brand-icon">K</span>
            <div>
                <h2>Kernel Query</h2>
                <p>OS + DBMS Monitor</p>
            </div>
        </div>

        <nav>
            <a class="nav-item active" href="#dashboard">▦ &nbsp; Dashboard</a>
            <a class="nav-item" href="#processes">▤ &nbsp; Processes</a>
            <a class="nav-item" href="#system">⌘ &nbsp; System overview</a>
        </nav>

        <div class="sidebar-footer">
            <span class="status-dot"></span>
            <span>Oracle database</span>
            <strong>Connected</strong>
        </div>
    </aside>

    <main class="main-content" id="dashboard">
        <header class="topbar">
            <div>
                <p class="eyebrow">OPERATING SYSTEM / DATABASE</p>
                <h1>System Dashboard</h1>
                <p class="subtitle">Monitor processes registered in your Oracle database.</p>
            </div>
            <button id="refreshBtn">↻ Refresh data</button>
        </header>

        <section class="summary-grid" id="system">
            <article class="summary-card">
                <p>Total processes</p>
                <h2 id="totalProcesses">—</h2>
                <span>Records for selected computer</span>
            </article>
            <article class="summary-card">
                <p>Computer</p>
                <h2 class="computer-value" id="computerName">—</h2>
                <span>Registered system</span>
            </article>
            <article class="summary-card">
                <p>API status</p>
                <h2 id="apiStatus">Checking</h2>
                <span id="lastUpdated">Waiting for first response</span>
            </article>
        </section>

        <section class="summary-grid" id="metrics">
            <article class="summary-card">
                <p>Average CPU usage</p>
                <h2 id="averageCpu">—</h2>
                <span>Across measured processes</span>
            </article>
            <article class="summary-card">
                <p>Total measured memory</p>
                <h2 id="totalMemory">—</h2>
                <span>Sum of process memory (MB)</span>
            </article>
            <article class="summary-card">
                <p>Metrics status</p>
                <h2 id="metricsStatus">Checking</h2>
                <span id="metricsUpdated">Waiting for measurements</span>
            </article>
        </section>

        <section class="panel" id="processes">
            <div class="panel-header">
                <div>
                    <h2>Process registry</h2>
                    <p>Process records retrieved from Oracle through the C++ REST API.</p>
                </div>
                <span class="record-count" id="recordCount">0 records</span>
            </div>

            <div class="toolbar">
                <input id="searchInput" type="search"
                       placeholder="Search by process name or PID..."
                       aria-label="Search processes">
                <label for="computerId">Computer ID</label>
                <input id="computerId" type="number" min="1" value="1">
            </div>

            <p id="message" class="message" role="status">Loading processes...</p>

            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>PID</th>
                            <th>Process name</th>
                            <th>Computer</th>
                            <th>CPU (%)</th>
                            <th>Memory (MB)</th>
                            <th>Last measured</th>
                        </tr>
                    </thead>
                    <tbody id="processTable">
                        <tr><td colspan="6">Loading data...</td></tr>
                    </tbody>
                </table>
            </div>
        </section>

        <footer>
            Kernel Query Execution and Paging System
            <span>Frontend · C++ REST API · Oracle SQL</span>
        </footer>
    </main>

    <script src="js/app.js"></script>
</body>
</html>
